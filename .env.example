# ─────────────────────────────────────────────────────────────────────────────
# HealthNexus — Monorepo Root Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend Configuration (backend/.env) ──────────────────────────────────
PORT=8000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
BCRYPT_SALT_ROUNDS=10
GEMINI_API_KEY=your_gemini_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Firebase Service Account:
# Place service-account.json inside backend/ directory
# Or configure FIREBASE_SERVICE_ACCOUNT base64 string for deployment

# ── Frontend Configuration (frontend_react/.env) ───────────────────────────
VITE_API_URL=http://localhost:8000
