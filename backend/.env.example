# ─────────────────────────────────────────────────────────────────────────────
# HealthNexus Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env or service-account.json to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8000

# ── CORS (comma-separated allowed frontend origins) ─────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Firebase Admin SDK & Storage ──────────────────────────────────────────
# Place your Firebase service account JSON at backend/service-account.json
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Or set FIREBASE_SERVICE_ACCOUNT as raw JSON or base64 string
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ── Password Hashing ────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=10

# ── Google Gemini AI ────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Twilio SMS (optional — used for future notification features) ────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
